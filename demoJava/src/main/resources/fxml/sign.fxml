                                                    <Label text="CH&#7916; K&#221; S" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                                    <TextField fx:id="fileSField" editable="false" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 4; -fx-padding: 6;"/>
