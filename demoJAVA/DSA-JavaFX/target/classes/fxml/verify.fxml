<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="page-scroll"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.VerifyController">
    <content>
<VBox fx:id="root" spacing="18" styleClass="page-fill responsive-page">
        <padding>
            <Insets top="24" right="32" bottom="28" left="32"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Xác thực chữ ký" styleClass="page-heading"/>
                <Label text="Kiểm tra chữ ký DSA, so sánh mã băm và phát hiện dữ liệu bị chỉnh sửa."
                       wrapText="true" styleClass="muted-label"/>
            </VBox>
            <Button onAction="#handleShowGuide" styleClass="secondary-button" text="Hướng dẫn"/>
        </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="workspace-tabs" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Xác thực văn bản">
                <content>
                    <SplitPane dividerPositions="0.70" styleClass="workspace-split">
                        <items>
                            <VBox spacing="12" styleClass="viewer-card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Văn bản gốc" styleClass="viewer-title"/>
                                    <Label text="XÁC THỰC" styleClass="tiny-badge"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="Nội dung cần kiểm tra" styleClass="muted-label"/>
                                </HBox>
                                <TextArea fx:id="textInput" promptText="Nhập văn bản gốc" wrapText="true"
                                          styleClass="document-editor" VBox.vgrow="ALWAYS"/>
                            </VBox>

                            <VBox spacing="14" styleClass="action-panel">
                                <Label text="Khu vực thao tác" styleClass="panel-title"/>
                                <VBox spacing="8" styleClass="control-card">
                                    <Label text="Chữ ký" styleClass="field-label"/>
                                    <Button maxWidth="Infinity" onAction="#handleChooseTextSignature" styleClass="primary-button" text="Chọn chữ ký"/>
                                    <Label fx:id="textSignatureLabel" text="Chưa chọn chữ ký" styleClass="muted-label" wrapText="true"/>
                                </VBox>
                                <VBox spacing="8" styleClass="control-card">
                                    <Label text="Khóa công khai" styleClass="field-label"/>
                                    <Button maxWidth="Infinity" onAction="#handleChooseTextPublicKey" styleClass="secondary-button" text="Chọn khóa công khai"/>
                                    <Label fx:id="textPublicKeyLabel" text="Chưa chọn khóa công khai" styleClass="muted-label" wrapText="true"/>
                                </VBox>
                                <VBox spacing="10" styleClass="control-card">
                                    <Button maxWidth="Infinity" onAction="#handleVerifyText" styleClass="success-button" text="Xác thực"/>
                                    <Button maxWidth="Infinity" onAction="#handleClearText" styleClass="danger-button" text="Làm mới"/>
                                </VBox>
                                <VBox spacing="8" styleClass="status-card">
                                    <Label text="Trạng thái thao tác" styleClass="section-title"/>
                                    <Label fx:id="textStatusMessage" text="Sẵn sàng" wrapText="true" styleClass="success-text"/>
                                </VBox>
                            </VBox>
                        </items>
                    </SplitPane>
                </content>
            </Tab>

            <Tab text="Xác thực tệp">
                <content>
                    <HBox spacing="20">
                        <VBox spacing="16" HBox.hgrow="ALWAYS">
                            <VBox spacing="18" styleClass="viewer-card">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label text="1" styleClass="step-index"/>
                                    <Label text="Tải lên tài liệu cần xác thực" styleClass="page-heading"/>
                                </HBox>
                                <HBox spacing="20">
                                    <VBox spacing="10" styleClass="upload-tile" HBox.hgrow="ALWAYS">
                                        <Label text="Tệp gốc" styleClass="upload-tile-title"/>
                                        <Button maxWidth="Infinity" onAction="#handleChooseOriginalFile" styleClass="secondary-button" text="Chọn tệp gốc"/>
                                        <Label fx:id="originalFileLabel" text="Chưa chọn tệp gốc" styleClass="upload-tile-text" wrapText="true"/>
                                    </VBox>
                                    <VBox spacing="10" styleClass="upload-tile" HBox.hgrow="ALWAYS">
                                        <Label text="Tệp chữ ký" styleClass="upload-tile-title"/>
                                        <Button maxWidth="Infinity" onAction="#handleChooseFileSignature" styleClass="secondary-button" text="Chọn chữ ký"/>
                                        <Label fx:id="fileSignatureLabel" text="Chưa chọn chữ ký" styleClass="upload-tile-text" wrapText="true"/>
                                    </VBox>
                                    <VBox spacing="10" styleClass="upload-tile" HBox.hgrow="ALWAYS">
                                        <Label text="Khóa công khai" styleClass="upload-tile-title"/>
                                        <Button maxWidth="Infinity" onAction="#handleChooseFilePublicKey" styleClass="secondary-button" text="Chọn khóa công khai"/>
                                        <Label fx:id="filePublicKeyLabel" text="Chưa chọn khóa công khai" styleClass="upload-tile-text" wrapText="true"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="process-card">
                                <Label text="2" styleClass="step-index"/>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Tiến hành xác thực" styleClass="page-heading"/>
                                    <Label text="Hệ thống so sánh mã băm và kiểm tra tính toàn vẹn của chữ ký." wrapText="true" styleClass="muted-label"/>
                                </VBox>
                                <Button onAction="#handleVerifyFile" styleClass="success-button" text="Xác thực ngay"/>
                                <Button onAction="#handleClearFile" styleClass="danger-button" text="Làm mới"/>
                            </HBox>

                            <VBox spacing="12" styleClass="viewer-card preview-card" VBox.vgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Xem trước tài liệu" styleClass="viewer-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#handleFileZoomOut" styleClass="secondary-button" text="Thu nhỏ"/>
                                    <Button onAction="#handleFileZoomIn" styleClass="secondary-button" text="Phóng to"/>
                                    <Button onAction="#handleFileFitWidth" styleClass="secondary-button" text="Vừa chiều rộng"/>
                                </HBox>
                                <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="document-tabs preview-tabs" VBox.vgrow="ALWAYS">
                                    <tabs>
                                        <Tab text="Xem định dạng">
                                            <content>
                                                <StackPane styleClass="preview-stack">
                                                    <ScrollPane fx:id="fileFormattedScroll" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                                                        <content>
                                                            <VBox fx:id="fileFormattedPages" alignment="TOP_CENTER" spacing="16" styleClass="formatted-pages"/>
                                                        </content>
                                                    </ScrollPane>
                                                    <WebView fx:id="fileDocxWebView" managed="false" visible="false"/>
                                                    <TabPane fx:id="fileWorkbookTabs" managed="false" tabClosingPolicy="UNAVAILABLE" visible="false"/>
                                                </StackPane>
                                            </content>
                                        </Tab>
                                        <Tab text="Văn bản thuần">
                                            <content>
                                                <TextArea fx:id="filePlainTextArea" editable="false" wrapText="false"
                                                          styleClass="document-viewer"/>
                                            </content>
                                        </Tab>
                                        <Tab text="Thông tin tệp">
                                            <content>
                                                <TextArea fx:id="fileInfoArea" editable="false" wrapText="true"
                                                          styleClass="metadata-viewer"/>
                                            </content>
                                        </Tab>
                                        <Tab text="Mã băm">
                                            <content>
                                                <TextArea fx:id="fileHashArea" editable="false" wrapText="true"
                                                          styleClass="hash-viewer"/>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </VBox>
                        </VBox>

                        <VBox spacing="18" styleClass="result-panel">
                            <Label text="Kết quả kiểm tra" styleClass="panel-title"/>
                            <Region prefHeight="1" style="-fx-background-color: #e4e6f2;"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Label text="..." styleClass="result-empty-icon"/>
                            <Label text="Chờ tải dữ liệu..." styleClass="result-muted"/>
                            <Label fx:id="fileStatusMessage" text="Sẵn sàng" wrapText="true" styleClass="success-text"/>
                            <Region VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
    </VBox>
    </content>
</ScrollPane>
