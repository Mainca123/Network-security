<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" stylesheets="@../css/style.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.MainController">
    <left>
        <VBox minWidth="210" prefWidth="240" maxWidth="276" spacing="8" styleClass="sidebar">
            <padding>
                <Insets top="28" right="14" bottom="20" left="14"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="brand-block">
                <Label text="DSA" styleClass="brand-mark"/>
                <VBox spacing="2">
                    <Label text="Hệ thống DSA" styleClass="brand-title"/>
                    <Label text="Quản lý chữ ký số" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Region prefHeight="20"/>
            <Button fx:id="manualButton" maxWidth="Infinity" onAction="#showManualParameter" styleClass="nav-button" text="Tham số DSA"/>
            <Button fx:id="autoKeyButton" maxWidth="Infinity" onAction="#showAutoKey" styleClass="nav-button" text="Tạo khóa"/>
            <Button fx:id="signButton" maxWidth="Infinity" onAction="#showSign" styleClass="nav-button" text="Ký dữ liệu"/>
            <Button fx:id="verifyButton" maxWidth="Infinity" onAction="#showVerify" styleClass="nav-button" text="Xác thực chữ ký"/>
            <Button fx:id="logButton" maxWidth="Infinity" onAction="#showLog" styleClass="nav-button" text="Nhật ký hệ thống"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header">
            <padding>
                <Insets top="18" right="28" bottom="18" left="30"/>
            </padding>
            <Label fx:id="currentPageLabel" text="Tham số DSA" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="notificationButton" onAction="#showNotifications" styleClass="header-chip-button" text="Thông báo (0)"/>
            <Label fx:id="clockLabel" text="--:--:--" styleClass="header-chip"/>
            <Label text="Sẵn sàng" styleClass="status-pill" fx:id="statusLabel"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>
</BorderPane>
