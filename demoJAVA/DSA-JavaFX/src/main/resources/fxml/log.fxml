<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="page-scroll"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LogController">
    <content>
<VBox spacing="16" styleClass="page-fill responsive-page">
        <padding>
            <Insets top="18" right="20" bottom="18" left="20"/>
        </padding>
    <VBox spacing="12" styleClass="viewer-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Nhật ký hệ thống" styleClass="viewer-title"/>
            <Label text="DỮ LIỆU" styleClass="tiny-badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="summaryLabel" text="Chưa có nhật ký hệ thống." wrapText="true" styleClass="muted-label"/>
        </HBox>
        <HBox spacing="12">
            <TextField fx:id="searchField" promptText="Tìm kiếm nhật ký" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="filterCombo" prefWidth="230"/>
            <Button onAction="#handleRefresh" styleClass="secondary-button" text="Làm mới"/>
            <Button onAction="#handleClearLogs" styleClass="danger-button" text="Xóa nhật ký"/>
        </HBox>
        <ListView fx:id="logListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>
    </content>
</ScrollPane>
